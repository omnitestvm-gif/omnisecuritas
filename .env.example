# Copy this file to .env.local. Never commit .env.local or share its contents.
# Gmail requires 2-Step Verification and a dedicated App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER. For Gmail it must match SMTP_USER.
SMTP_FROM=
# Production custom domains and stable aliases, comma-separated. No trailing paths.
# Vercel's deployment URL and project production URL are also allowed automatically.
CONTACT_ALLOWED_ORIGINS=https://omnisecuritas.com.ph,https://www.omnisecuritas.com.ph
